---
import { typingRoles } from '../data/resume';
import { site, withBase } from '../data/site';
import LinkRow from './LinkRow.astro';

const rolesJson = JSON.stringify(typingRoles);
const nameParts = site.author.name.split(' ');
const firstName = nameParts.shift() ?? '';
const lastName = nameParts.join(' ');

// The personal "Connect on" row drops RSS — it would sit directly under the
// podcast feed's RSS pill above and just duplicate it visually. RSS to the
// site's own feed still lives in the footer.
const connectSocials = Object.fromEntries(
  Object.entries(site.socials).filter(([key]) => key !== 'rss'),
);
---

<section class="hero">
  <div class="stars" aria-hidden="true"></div>
  <div class="container hero-inner">
    <div>
      <p class="hero-greeting">Hello, I'm</p>
      <h1>{firstName} {lastName && <span class="accent">{lastName}</span>}</h1>
      <p class="hero-typed">
        <span class="typed" id="typed-roles" data-roles={rolesJson}></span><span class="typed-cursor" aria-hidden="true">▍</span>
      </p>

      <p class="hero-bio">
        Write a short bio here — who you are, what you build, what you're
        curious about. Two or three sentences is plenty.
      </p>

      <LinkRow heading="Listen on" links={site.podcast.links} linkClass="podcast-link" class="hero-podcast-links" />

      <LinkRow heading="Connect on" links={connectSocials} />
    </div>

    <img class="hero-avatar" src={withBase('/img/avatar.svg')} alt={`Portrait of ${site.author.name}`} width="220" height="220" />
  </div>
</section>

<script>
  const el = document.getElementById('typed-roles');
  if (el) {
    const roles: string[] = JSON.parse(el.dataset.roles ?? '[]');
    let roleIndex = 0;
    let charIndex = 0;
    let deleting = false;

    const tick = () => {
      const word = roles[roleIndex];
      if (!deleting) {
        charIndex++;
        el.textContent = word.slice(0, charIndex);
        if (charIndex === word.length) {
          deleting = true;
          setTimeout(tick, 1800);
          return;
        }
        setTimeout(tick, 70);
      } else {
        charIndex--;
        el.textContent = word.slice(0, charIndex);
        if (charIndex === 0) {
          deleting = false;
          roleIndex = (roleIndex + 1) % roles.length;
          setTimeout(tick, 350);
          return;
        }
        setTimeout(tick, 35);
      }
    };

    tick();
  }
</script>
