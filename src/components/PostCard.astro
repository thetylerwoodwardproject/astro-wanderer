---
import type { CollectionEntry } from 'astro:content';
import { withBase } from '../data/site';
import AudioPlayer from './AudioPlayer.astro';

type Post = CollectionEntry<'blog'>;

interface Props {
  post: Post;
}

const { post } = Astro.props;

const readingTime = Math.max(1, Math.ceil((post.body?.split(/\s+/).length ?? 0) / 220));
const dateFmt = new Intl.DateTimeFormat('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
---

<article class="post-card">
  <div class="post-meta">
    <span class="category-badge {post.data.category}">{post.data.category}</span>
    <time datetime={post.data.date.toISOString()}>{dateFmt.format(post.data.date)}</time>
    <span class="dot">·</span>
    <span>{readingTime} min read</span>
    {post.data.updated && (
      <>
        <span class="dot">·</span>
        <span>updated {dateFmt.format(post.data.updated)}</span>
      </>
    )}
  </div>
  <h3><a href={withBase(`/blog/${post.id}/`)}>{post.data.title}</a></h3>
  {post.data.subtitle && <p class="post-sub">{post.data.subtitle}</p>}
  <p class="post-excerpt">
    {(post.data.description ?? post.body ?? '').slice(0, 200)}
    {((post.data.description ?? post.body ?? '').length > 200 ? '…' : '')}
  </p>
  {post.data.audio && (
    <AudioPlayer
      src={withBase(post.data.audio.src)}
      title={post.data.audio.title ?? post.data.title}
      duration={post.data.audio.duration}
      variant="compact"
    />
  )}
  {post.data.tags.length > 0 && (
    <div class="tag-list">
      {post.data.tags.map((t) => <span class="tag">{t}</span>)}
    </div>
  )}
</article>
